{
  "manifest_version": 3,
  "name": "Claude Usage",
  "version": "1.1.0",
  "description": "Visar hur mycket av din Claude-usage du har använt, direkt på ikonen i verktygsfältet.",
  "permissions": ["alarms", "storage", "cookies"],
  "host_permissions": ["https://claude.ai/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Usage",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
